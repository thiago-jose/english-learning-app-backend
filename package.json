{
  "name": "english-learning-app-backend",
  "version": "1.0.0",
  "description": "Backend for English Learning App",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --config jest.config.js --testMatch='**/__tests__/unit/**/*.test.ts'",
    "test:integ": "jest --config jest.config.js --testMatch='**/__tests__/integ/**/*.test.ts'",
    "lint": "eslint . --ext .ts",
    "sam:build": "sam build",
    "sam:deploy:dev": "sam deploy --config-env dev",
    "sam:deploy:prod": "sam deploy --config-env prod",
    "sam:delete:dev": "sam delete --config-env dev",
    "sam:delete:prod": "sam delete --config-env prod",
    "generate-env:dev": "ts-node scripts/generate-env.ts dev",
    "generate-env:prod": "ts-node scripts/generate-env.ts prod",
    "test:integ:dev": "npm run generate-env:dev && npm run test:integ",
    "test:integ:prod": "npm run generate-env:prod && npm run test:integ"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "aws-lambda": "^1.0.7",
    "aws-sdk": "^2.1001.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.136",
    "@types/aws-sdk": "^2.7.4",
    "@types/axios": "^0.9.36",
    "@types/dotenv": "^6.1.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "@types/uuid": "^9.0.6",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
