{
  "name": "english-learning-app-backend",
  "version": "1.0.0",
  "description": "Backend for English Learning Application",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integ": "jest --config jest.config.js --testMatch='**/__tests__/integ/**/*.test.ts'",
    "lint": "eslint . --ext .ts",
    "deploy:dev": "chmod +x scripts/deploy.sh && ./scripts/deploy.sh --env dev",
    "deploy:test": "chmod +x scripts/deploy.sh && ./scripts/deploy.sh --env test",
    "deploy:prod": "chmod +x scripts/deploy.sh && ./scripts/deploy.sh --env prod",
    "generate-types": "openapi --input src/presentation/controllers/openapi.yml --output src/presentation/controllers/generated --client axios",
    "generate-env:dev": "ts-node scripts/generate-env.ts dev",
    "generate-env:test": "ts-node scripts/generate-env.ts test",
    "generate-env:prod": "ts-node scripts/generate-env.ts prod",
    "test:integ:dev": "npm run generate-env:dev && npm run test:integ",
    "test:integ:test": "npm run generate-env:test && npm run test:integ",
    "test:integ:prod": "npm run generate-env:prod && npm run test:integ"
  },
  "dependencies": {
    "aws-sdk": "^2.1499.0",
    "axios": "^1.6.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/aws-lambda": "^8.10.119",
    "@types/aws-sdk": "^2.7.4",
    "@types/axios": "^0.9.36",
    "@types/dotenv": "^6.1.1",
    "@types/jest": "^29.5.6",
    "@types/node": "^20.19.0",
    "@types/uuid": "^9.0.6",
    "@typescript-eslint/eslint-plugin": "^6.11.0",
    "@typescript-eslint/parser": "^6.11.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "openapi-typescript-codegen": "^0.27.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
